{
  "cursor": {
    "version": 1,
    "hooks": {
      "beforeShellExecution": [
        {
          "command": "$HOOKS_DIR/block-dangerous.sh"
        },
        {
          "command": "$HOOKS_DIR/notify-permission.sh"
        }
      ],
      "preToolUse": [
        {
          "command": "$HOOKS_DIR/block-dangerous.sh",
          "matcher": "Delete|Shell"
        },
        {
          "command": "$HOOKS_DIR/protect-files.sh",
          "matcher": "Delete|Write"
        }
      ],
      "beforeMCPExecution": [
        {
          "command": "$HOOKS_DIR/notify-permission.sh"
        }
      ],
      "stop": [
        {
          "command": "$HOOKS_DIR/notify-done.sh"
        }
      ]
    }
  },
  "claude": {
    "hooks": {
      "PreToolUse": [
        {
          "matcher": "Bash",
          "hooks": [
            {
              "type": "command",
              "command": "$HOOKS_DIR/block-dangerous.sh"
            }
          ]
        },
        {
          "matcher": "Edit|Write",
          "hooks": [
            {
              "type": "command",
              "command": "$HOOKS_DIR/protect-files.sh"
            }
          ]
        }
      ],
      "Notification": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "$HOOKS_DIR/notify-permission.sh"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "$HOOKS_DIR/notify-done.sh"
            }
          ]
        }
      ]
    }
  }
}
